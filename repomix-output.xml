<file path="frontend-consultoria/src/App.js">
import React, { useState, useEffect, useRef } from 'react';
import axios from 'axios';
import './App.css';
import AbaDiario from './AbaDiario';
import AbaDashboard from './AbaDashboard';

const LOGO_MARCA_URL = "/logo.png";

axios.defaults.withCredentials = true;

const API_URL = 'http://127.0.0.1:8000/api';

function App() {
  const formRef = useRef(null);

  const [abaAtiva, setAbaAtiva] = useState('recomendacao');
  const [usuario, setUsuario] = useState(null);
  const [modoAuth, setModoAuth] = useState('login');
  const [mostrarModalGoogle, setMostrarModalGoogle] = useState(false);
  const [modoOutraContaGoogle, setModoOutraContaGoogle] = useState(false);
  const [novoNomeGoogle, setNovoNomeGoogle] = useState('');
  const [novoEmailGoogle, setNovoEmailGoogle] = useState('');

  const contasGoogleExemplo = [
    {
      nome: "Maria Victoria Scanholato",
      email: "maviiscanholato@gmail.com",
      foto: "https://ui-avatars.com/api/?name=Maria+Victoria&background=e8f0fe&color=1a73e8&bold=true"
    },
    {
      nome: "Maria Victoria Scanholato",
      email: "mariavictoriasds17@gmail.com",
      foto: "https://ui-avatars.com/api/?name=Maria+Scanholato&background=fce8e6&color=c5221f&bold=true"
    }
  ];

  const [authUsername, setAuthUsername] = useState('');
  const [authPassword, setAuthPassword] = useState('');
  const [authNovaSenha, setAuthNovaSenha] = useState('');
  const [authEmail, setAuthEmail] = useState('');
  const [authErro, setAuthErro] = useState('');
  const [authSucesso, setAuthSucesso] = useState('');

  const [pecas, setPecas] = useState([]);
  const [looks, setLooks] = useState([]);

  const [categoria, setCategoria] = useState('');
  const [cor, setCor] = useState('');
  const [estilo, setEstilo] = useState('');
  const [clima, setClima] = useState('');
  const [imagem, setImagem] = useState(null);
  const [statusCadastro, setStatusCadastro] = useState('');

  const [pecaEmEdicao, setPecaEmEdicao] = useState(null);
  const [editCategoria, setEditCategoria] = useState('');
  const [editCor, setEditCor] = useState('');
  const [editEstilo, setEditEstilo] = useState('');
  const [editClima, setEditClima] = useState('');
  const [editImagem, setEditImagem] = useState(null);

  const [lookGerado, setLookGerado] = useState(null);
  const [carregandoLook, setCarregandoLook] = useState(false);
  const [favoritos, setFavoritos] = useState([]);

  useEffect(() => {
    verificarUsuario();
  }, []);

  const verificarUsuario = () => {
    axios.get(`${API_URL}/auth/me/`)
      .then(res => {
        if (res.data.autenticado) {
          setUsuario(res.data.user);
          carregarDados();
        } else {
          setUsuario(null);
        }
      })
      .catch(() => setUsuario(null));
  };

  const carregarDados = () => {
    axios.get(`${API_URL}/pecas/`)
      .then(res => setPecas(Array.isArray(res.data) ? res.data : []))
      .catch(err => console.error("Erro ao buscar peças:", err));

    axios.get(`${API_URL}/diario/`)
      .then(res => setLooks(Array.isArray(res.data) ? res.data : []))
      .catch(() => {
        axios.get(`${API_URL}/looks/`)
          .then(res => setLooks(Array.isArray(res.data) ? res.data : []))
          .catch(err => console.error("Erro ao buscar histórico de looks:", err));
      });
  };

  const handleLogin = (e) => {
    e.preventDefault();
    setAuthErro('');
    setAuthSucesso('');
    axios.post(`${API_URL}/auth/login/`, { username: authUsername, password: authPassword })
      .then(res => {
        setUsuario(res.data.user);
        setAuthUsername('');
        setAuthPassword('');
        carregarDados();
      })
      .catch(err => setAuthErro(err.response?.data?.erro || 'Erro ao realizar login.'));
  };

  const handleCadastro = (e) => {
    e.preventDefault();
    setAuthErro('');
    setAuthSucesso('');
    axios.post(`${API_URL}/auth/cadastrar/`, { username: authUsername, password: authPassword, email: authEmail })
      .then(res => {
        setUsuario(res.data.user);
        setAuthUsername('');
        setAuthPassword('');
        setAuthEmail('');
        carregarDados();
      })
      .catch(err => setAuthErro(err.response?.data?.erro || 'Erro ao realizar cadastro.'));
  };

  const handleAlterarSenha = (e) => {
    e.preventDefault();
    setAuthErro('');
    setAuthSucesso('');
    axios.post(`${API_URL}/auth/alterar-senha/`, { senha_atual: authPassword, nova_senha: authNovaSenha })
      .then(res => {
        setAuthSucesso(res.data.mensagem);
        setAuthPassword('');
        setAuthNovaSenha('');
      })
      .catch(err => setAuthErro(err.response?.data?.erro || 'Erro ao alterar senha.'));
  };

  const handleGoogleLogin = () => {
    setModoOutraContaGoogle(false);
    setMostrarModalGoogle(true);
  };

  const selecionarContaGoogle = (conta) => {
    setUsuario({ username: conta.nome });
    localStorage.setItem("usuario", JSON.stringify({ username: conta.nome }));
    setMostrarModalGoogle(false);
    setModoOutraContaGoogle(false);

    if (typeof carregarDados === "function") {
      carregarDados();
    }
  };

  const handleEntrarComOutraContaGoogle = (e) => {
    e.preventDefault();
    if (!novoNomeGoogle) return;
    selecionarContaGoogle({ nome: novoNomeGoogle, email: novoEmailGoogle || `${novoNomeGoogle.toLowerCase().replace(/\s+/g, '')}@gmail.com` });
    setNovoNomeGoogle('');
    setNovoEmailGoogle('');
  };

  const handleLogout = () => {
    axios.post(`${API_URL}/auth/logout/`)
      .then(() => {
        setUsuario(null);
        setPecas([]);
        setLooks([]);
        setLookGerado(null);
        setModoAuth('login');
      })
      .catch(err => console.error("Erro ao sair:", err));
  };

  const handleCadastrarPeca = (e) => {
    e.preventDefault();
    setStatusCadastro('Enviando dados...');

    if (!categoria || !cor) {
      setStatusCadastro('Por favor, preencha Categoria e Cor.');
      return;
    }

    if (!imagem) {
      setStatusCadastro('Por favor, selecione uma imagem para a peça.');
      return;
    }

    const formData = new FormData();
    formData.append('categoria', categoria);
    formData.append('cor', cor);
    formData.append('estilo', estilo);
    formData.append('clima', clima);
    formData.append('imagem', imagem);

    axios.post(`${API_URL}/pecas/`, formData, {
      headers: { 'Content-Type': 'multipart/form-data' },
    })
    .then(() => {
      setStatusCadastro('Peça cadastrada com sucesso!');
      setCategoria('');
      setCor('');
      setEstilo('');
      setClima('');
      setImagem(null);

      if (formRef.current) {
        formRef.current.reset();
      }

      carregarDados();
    })
    .catch(error => {
      console.error('Erro no cadastro:', error.response?.data);
      const detalhe = error.response?.data
        ? JSON.stringify(error.response.data)
        : 'Verifique se o Django está ativo.';
      setStatusCadastro(`Erro ao cadastrar: ${detalhe}`);
    });
  };

  const handleDeletarPeca = (id) => {
    if (window.confirm('Tem certeza que deseja excluir esta peça?')) {
      axios.delete(`${API_URL}/pecas/${id}/`)
        .then(() => carregarDados())
        .catch(err => console.error("Erro ao deletar peça:", err));
    }
  };

  const abrirEdicao = (peca) => {
    setPecaEmEdicao(peca);
    setEditCategoria(peca.categoria);
    setEditCor(peca.cor);
    setEditEstilo(peca.estilo);
    setEditClima(peca.clima);
    setEditImagem(null);
  };

  const handleSalvarEdicao = (e) => {
    e.preventDefault();
    const formData = new FormData();
    formData.append('categoria', editCategoria);
    formData.append('cor', editCor);
    formData.append('estilo', editEstilo);
    formData.append('clima', editClima);

    if (editImagem) {
      formData.append('imagem', editImagem);
    }

    axios.patch(`${API_URL}/pecas/${pecaEmEdicao.id}/`, formData, {
      headers: { 'Content-Type': 'multipart/form-data' },
    })
    .then(() => {
      setPecaEmEdicao(null);
      carregarDados();
    })
    .catch(err => console.error("Erro ao editar peça:", err));
  };

  const handleGerarLook = (climaFiltro) => {
    setCarregandoLook(true);
    setLookGerado(null);

    axios.post(`${API_URL}/looks/gerar_look/`, {
      clima: climaFiltro
    })
    .then(res => {
      setLookGerado(res.data.look);
      carregarDados();
    })
    .catch(err => {
      alert(err.response?.data?.erro || "Erro ao gerar look.");
    })
    .finally(() => setCarregandoLook(false));
  };

  const handleFavoritarLook = (look) => {
    if (!favoritos.some(fav => fav.nome_look === look.nome_look)) {
      setFavoritos([...favoritos, look]);
      alert("Look adicionado aos favoritos!");
    } else {
      alert("Este look já está nos seus favoritos.");
    }
  };

  const limparMensagemStatus = () => {
    if (statusCadastro) setStatusCadastro('');
  };

  return (
    <div style={{ minHeight: '100vh', background: 'linear-gradient(180deg, #f4fbfb 0%, #ffffff 100%)', padding: '40px 20px', fontFamily: 'Segoe UI, sans-serif' }}>
      <div style={{ maxWidth: '850px', margin: '0 auto' }}>

        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: '#ffffff', padding: '16px 24px', borderRadius: '16px', marginBottom: '25px', boxShadow: '0 10px 25px rgba(168, 220, 217, 0.25)', border: '1px solid #a8dcd9' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '15px' }}>
            {LOGO_MARCA_URL && (
              <img src={LOGO_MARCA_URL} alt="Logo da Marca" style={{ height: '55px', transform: 'scale(1.1)', objectFit: 'contain' }} />
            )}
            <h1 style={{ margin: 0, fontSize: '1.3rem', color: '#000000', fontWeight: '700', letterSpacing: '-0.3px' }}>
              Meu Closet Digital
            </h1>
          </div>

          {usuario ? (
            <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
              <span style={{ fontWeight: '600', color: '#000000', fontSize: '0.95rem' }}>Olá, {usuario.username}!</span>
              <button onClick={handleLogout} style={btnExcluir}>Sair</button>
            </div>
          ) : (
            <span style={{ fontSize: '0.85rem', color: '#000000' }}></span>
          )}
        </div>

        {!usuario || modoAuth === 'senha' ? (
          <div style={{ background: '#ffffff', border: '1px solid #a8dcd9', padding: '35px', borderRadius: '20px', maxWidth: '400px', margin: '30px auto', boxShadow: '0 12px 30px rgba(0, 0, 0, 0.05)' }}>

            <div style={{ textAlign: 'center', marginBottom: '25px' }}>
              {LOGO_MARCA_URL && (
                <img src={LOGO_MARCA_URL} alt="Logo da Marca" style={{ height: '115px', transform: 'scale(1.25)', objectFit: 'contain', marginBottom: '10px' }} />
              )}
              <h2 style={{ color: '#000000', margin: 0, fontSize: '1.4rem' }}>
                {modoAuth === 'login' && 'Entrar na Conta'}
                {modoAuth === 'cadastro' && 'Criar Nova Conta'}
                {modoAuth === 'senha' && 'Alterar Senha'}
              </h2>
            </div>

            {modoAuth === 'senha' && (
              <form onSubmit={handleAlterarSenha}>
                <div style={{ marginBottom: '15px' }}>
                  <label style={labelStyle}>Senha Atual:</label>
                  <input type="password" value={authPassword} onChange={e => setAuthPassword(e.target.value)} style={inputStyle} required />
                </div>
                <div style={{ marginBottom: '20px' }}>
                  <label style={labelStyle}>Nova Senha:</label>
                  <input type="password" value={authNovaSenha} onChange={e => setAuthNovaSenha(e.target.value)} style={inputStyle} required />
                </div>
                <button type="submit" style={btnPrincipal}>Salvar Nova Senha</button>
                <button type="button" onClick={() => setModoAuth('login')} style={{ ...btnCancelar, marginTop: '10px' }}>
                  Voltar para o Login
                </button>
              </form>
            )}

            {modoAuth !== 'senha' && (
              <form onSubmit={modoAuth === 'cadastro' ? handleCadastro : handleLogin}>
                <div style={{ marginBottom: '15px' }}>
                  <label style={labelStyle}>Usuário:</label>
                  <input type="text" value={authUsername} onChange={e => setAuthUsername(e.target.value)} style={inputStyle} required placeholder="Seu usuário" />
                </div>

                {modoAuth === 'cadastro' && (
                  <div style={{ marginBottom: '15px' }}>
                    <label style={labelStyle}>E-mail (opcional):</label>
                    <input type="email" value={authEmail} onChange={e => setAuthEmail(e.target.value)} style={inputStyle} placeholder="Seu e-mail" />
                  </div>
                )}

                <div style={{ marginBottom: '20px' }}>
                  <label style={labelStyle}>Senha:</label>
                  <input type="password" value={authPassword} onChange={e => setAuthPassword(e.target.value)} style={inputStyle} required placeholder="Sua senha" />
                </div>

                <button type="submit" style={btnPrincipal}>
                  {modoAuth === 'cadastro' ? 'Cadastrar' : 'Entrar'}
                </button>
              </form>
            )}

            {authErro && <p style={{ color: '#000000', fontSize: '0.9rem', marginTop: '15px', textAlign: 'center' }}>{authErro}</p>}
            {authSucesso && <p style={{ color: '#000000', fontSize: '0.9rem', marginTop: '15px', textAlign: 'center', fontWeight: 'bold' }}>{authSucesso}</p>}

            {!usuario && modoAuth !== 'senha' && (
              <div style={{ textAlign: 'center', marginTop: '20px', fontSize: '0.85rem', color: '#000000', display: 'flex', flexDirection: 'column', gap: '12px' }}>

                {modoAuth === 'login' ? (
                  <>
                    <span onClick={() => { setModoAuth('cadastro'); setAuthErro(''); setAuthSucesso(''); }} style={linkStyle}>
                      Ainda não tem conta? Cadastre-se
                    </span>
                    <span onClick={() => { setModoAuth('senha'); setAuthErro(''); setAuthSucesso(''); }} style={linkStyle}>
                      Deseja alterar a senha?
                    </span>
                  </>
                ) : (
                  <span onClick={() => { setModoAuth('login'); setAuthErro(''); setAuthSucesso(''); }} style={linkStyle}>
                    Já tem uma conta? Faça Login
                  </span>
                )}

                <div style={{ display: 'flex', alignItems: 'center', margin: '10px 0' }}>
                  <div style={{ flex: 1, borderBottom: '1px solid #a8dcd9' }}></div>
                  <span style={{ padding: '0 10px', color: '#000000', fontSize: '0.75rem' }}>ou</span>
                  <div style={{ flex: 1, borderBottom: '1px solid #a8dcd9' }}></div>
                </div>

                <button onClick={handleGoogleLogin} style={btnGoogle}>
                  Entrar com o Google
                </button>

              </div>
            )}

          </div>
        ) : (
          <>
            <div style={{ display: 'flex', justifyContent: 'center', gap: '12px', marginBottom: '25px', flexWrap: 'wrap' }}>
              <button
                onClick={() => setAbaAtiva('dashboard')}
                style={abaAtiva === 'dashboard' ? btnAbaAtiva : btnAbaInativa}
              >
                Dashboard
              </button>
              <button
                onClick={() => setAbaAtiva('recomendacao')}
                style={abaAtiva === 'recomendacao' ? btnAbaAtiva : btnAbaInativa}
              >
                Recomendador IA
              </button>
              <button
                onClick={() => setAbaAtiva('cadastrar')}
                style={abaAtiva === 'cadastrar' ? btnAbaAtiva : btnAbaInativa}
              >
                Nova Peça
              </button>
              <button
                onClick={() => setAbaAtiva('guardaRoupa')}
                style={abaAtiva === 'guardaRoupa' ? btnAbaAtiva : btnAbaInativa}
              >
                Meu Guarda-Roupa
              </button>
              <button
                onClick={() => setAbaAtiva('favoritos')}
                style={abaAtiva === 'favoritos' ? btnAbaAtiva : btnAbaInativa}
              >
                Looks Favoritos
              </button>
              <button
                onClick={() => setAbaAtiva('diario')}
                style={abaAtiva === 'diario' ? btnAbaAtiva : btnAbaInativa}
              >
                Agenda de Looks
              </button>
            </div>

            {abaAtiva === 'dashboard' && (
              <AbaDashboard pecas={pecas} registros={looks} favoritos={favoritos} />
            )}

            {abaAtiva === 'recomendacao' && (
              <div style={{ background: '#ffffff', border: '1px solid #a8dcd9', padding: '30px', borderRadius: '20px', textAlign: 'center', marginBottom: '30px', boxShadow: '0 10px 25px rgba(0,0,0,0.03)' }}>
                <h2 style={{ color: '#000000', marginTop: 0, fontSize: '1.5rem' }}>Recomendador de Look Por IA</h2>
                <p style={{ color: '#555555', fontSize: '0.95rem' }}>Selecione a ocasião para que a inteligência monte o look perfeito:</p>
                <div style={{ display: 'flex', gap: '12px', justifyContent: 'center', marginTop: '20px' }}>
                  <button onClick={() => handleGerarLook('Geral')} style={btnSecundario}>Look Geral</button>
                  <button onClick={() => handleGerarLook('Verão')} style={btnSecundario}>Look Verão</button>
                  <button onClick={() => handleGerarLook('Inverno')} style={btnSecundario}>Look Inverno</button>
                </div>

                {carregandoLook && <p style={{ color: '#000000', fontWeight: 'bold', marginTop: '20px' }}>Gerando combinação...</p>}

                {lookGerado && (
                  <div style={{ marginTop: '25px', background: '#f8fdfd', border: '1px solid #a8dcd9', padding: '20px', borderRadius: '14px', textAlign: 'left' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', marginBottom: '10px' }}>
                      <h3 style={{ color: '#000000', margin: 0, fontSize: '1.1rem' }}>{lookGerado.nome_look}</h3>
                      <button onClick={() => handleFavoritarLook(lookGerado)} style={btnFavoritar}>Favoritar Look</button>
                    </div>
                    <p style={{ margin: '0 0 15px 0', color: '#444444', fontSize: '0.9rem' }}>{lookGerado.descricao}</p>

                    {lookGerado.pecas && lookGerado.pecas.length > 0 && (
                      <div style={{ display: 'flex', gap: '15px', marginTop: '15px', justifyContent: 'center', flexWrap: 'wrap' }}>
                        {lookGerado.pecas.map((item, index) => (
                          item.imagem && (
                            <div key={index} style={{ textAlign: 'center', background: '#ffffff', padding: '10px', borderRadius: '10px', boxShadow: '0 4px 10px rgba(0,0,0,0.03)' }}>
                              <img
                                src={item.imagem.startsWith('http') ? item.imagem : `http://127.0.0.1:8000${item.imagem}`}
                                alt={item.categoria}
                                style={{ width: '120px', height: '120px', objectFit: 'cover', borderRadius: '8px' }}
                              />
                              <p style={{ fontSize: '0.8rem', margin: '8px 0 0 0', textTransform: 'capitalize', color: '#000000', fontWeight: '600' }}>
                                {item.categoria} ({item.cor})
                              </p>
                            </div>
                          )
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
            )}

            {abaAtiva === 'cadastrar' && (
              <div style={{ background: '#ffffff', border: '1px solid #a8dcd9', padding: '30px', borderRadius: '20px', marginBottom: '30px', boxShadow: '0 10px 25px rgba(0,0,0,0.03)' }}>
                <h3 style={{ color: '#000000', marginTop: 0, marginBottom: '20px', fontSize: '1.3rem' }}>Adicionar Peça ao Closet</h3>

                <form ref={formRef} onSubmit={handleCadastrarPeca}>
                  <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '15px', marginBottom: '15px' }}>
                    <div>
                      <label style={labelStyle}>Categoria:</label>
                      <input type="text" value={categoria} onChange={e => { setCategoria(e.target.value); limparMensagemStatus(); }} style={inputStyle} placeholder="ex: Camiseta " />
                    </div>
                    <div>
                      <label style={labelStyle}>Cor:</label>
                      <input type="text" value={cor} onChange={e => { setCor(e.target.value); limparMensagemStatus(); }} style={inputStyle} placeholder="ex: Azul " />
                    </div>
                    <div>
                      <label style={labelStyle}>Estilo:</label>
                      <input type="text" value={estilo} onChange={e => { setEstilo(e.target.value); limparMensagemStatus(); }} style={inputStyle} placeholder="ex: Casual " />
                    </div>
                    <div>
                      <label style={labelStyle}>Clima Ideal:</label>
                      <input type="text" value={clima} onChange={e => { setClima(e.target.value); limparMensagemStatus(); }} style={inputStyle} placeholder="ex: Verão " />
                    </div>
                  </div>

                  <div style={{ marginBottom: '20px' }}>
                    <label style={labelStyle}>Fotografia da Peça:</label>
                    <input
                      type="file"
                      onChange={e => { setImagem(e.target.files[0]); limparMensagemStatus(); }}
                      accept="image/*"
                      style={{ width: '100%' }}
                    />
                  </div>

                  <button type="submit" style={btnPrincipal}>
                    Salvar Peça no Closet
                  </button>
                </form>

                {statusCadastro && (
                  <p style={{ color: '#000000', marginTop: '15px', fontWeight: 'bold' }}>
                    {statusCadastro}
                  </p>
                )}
              </div>
            )}

            {abaAtiva === 'guardaRoupa' && (
              <>
                <h2 style={{ color: '#000000', fontSize: '1.4rem', marginBottom: '20px' }}>
                  Meu Guarda-Roupa ({pecas.length} peças)
                </h2>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))', gap: '20px' }}>
                  {pecas.map(peca => (
                    <div key={peca.id} style={{ border: '1px solid #a8dcd9', borderRadius: '16px', overflow: 'hidden', background: '#ffffff', boxShadow: '0 4px 15px rgba(0,0,0,0.03)' }}>
                      {peca.imagem && (
                        <img src={peca.imagem} alt={peca.categoria} style={{ width: '100%', height: '180px', objectFit: 'cover' }} />
                      )}
                      <div style={{ padding: '15px' }}>
                        <h3 style={{ margin: '0 0 10px 0', textTransform: 'capitalize', color: '#000000', fontSize: '1.1rem' }}>
                          {peca.categoria} - {peca.cor}
                        </h3>
                        <p style={{ margin: '5px 0', fontSize: '0.85rem', color: '#555555' }}><strong>Estilo:</strong> {peca.estilo}</p>
                        <p style={{ margin: '5px 0', fontSize: '0.85rem', color: '#555555' }}><strong>Clima:</strong> {peca.clima}</p>

                        <div style={{ display: 'flex', gap: '8px', marginTop: '15px' }}>
                          <button onClick={() => abrirEdicao(peca)} style={btnEditar}>Editar</button>
                          <button onClick={() => handleDeletarPeca(peca.id)} style={btnExcluir}>Excluir</button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </>
            )}

            {abaAtiva === 'favoritos' && (
              <div style={{ background: '#ffffff', border: '1px solid #a8dcd9', padding: '30px', borderRadius: '20px', boxShadow: '0 10px 25px rgba(0,0,0,0.03)' }}>
                <h2 style={{ color: '#000000', marginTop: 0 }}> Favoritos</h2>
                <p style={{ color: '#555555' }}>Combinações salvas:</p>

                {favoritos.length === 0 ? (
                  <p style={{ color: '#777777', fontStyle: 'italic' }}>Nenhum look favoritado ainda.</p>
                ) : (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '20px', marginTop: '20px' }}>
                    {favoritos.map((fav, idx) => (
                      <div key={idx} style={{ border: '1px solid #a8dcd9', padding: '15px', borderRadius: '12px', background: '#f8fdfd' }}>
                        <h3 style={{ margin: '0 0 10px 0', color: '#000000' }}>{fav.nome_look}</h3>
                        <p style={{ margin: '0 0 10px 0', color: '#555555', fontSize: '0.9rem' }}>{fav.descricao}</p>
                        <div style={{ display: 'flex', gap: '10px' }}>
                          {fav.pecas?.map((p, i) => (
                            <img
                              key={i}
                              src={p.imagem.startsWith('http') ? p.imagem : `http://127.0.0.1:8000${p.imagem}`}
                              alt={p.categoria}
                              style={{ width: '80px', height: '80px', objectFit: 'cover', borderRadius: '8px', border: '1px solid #a8dcd9' }}
                            />
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}

            {abaAtiva === 'diario' && (
              <AbaDiario pecas={pecas} />
            )}

            {/* MODAL DE EDIÇÃO */}
            {pecaEmEdicao && (
              <div style={modalOverlay}>
                <div style={modalBox}>
                  <h3 style={{ marginTop: 0, color: '#000000' }}>Editar Peça</h3>
                  <form onSubmit={handleSalvarEdicao}>
                    <div style={{ marginBottom: '10px' }}>
                      <label style={labelStyle}>Categoria:</label>
                      <input value={editCategoria} onChange={e => setEditCategoria(e.target.value)} style={inputStyle} />
                    </div>
                    <div style={{ marginBottom: '10px' }}>
                      <label style={labelStyle}>Cor:</label>
                      <input value={editCor} onChange={e => setEditCor(e.target.value)} style={inputStyle} />
                    </div>
                    <div style={{ marginBottom: '10px' }}>
                      <label style={labelStyle}>Estilo:</label>
                      <input value={editEstilo} onChange={e => setEditEstilo(e.target.value)} style={inputStyle} />
                    </div>
                    <div style={{ marginBottom: '10px' }}>
                      <label style={labelStyle}>Clima:</label>
                      <input value={editClima} onChange={e => setEditClima(e.target.value)} style={inputStyle} />
                    </div>
                    <div style={{ marginBottom: '15px' }}>
                      <label style={labelStyle}>Alterar Foto (Opcional):</label>
                      <input type="file" onChange={e => setEditImagem(e.target.files[0])} accept="image/*" />
                    </div>
                    <div style={{ display: 'flex', gap: '10px' }}>
                      <button type="submit" style={btnPrincipal}>Salvar</button>
                      <button type="button" onClick={() => setPecaEmEdicao(null)} style={btnCancelar}>Cancelar</button>
                    </div>
                  </form>
                </div>
              </div>
            )}
          </>
        )}

      </div>

      {/* MODAL GOOGLE - COM FOTOS E AÇÃO DE USAR OUTRA CONTA */}
      {mostrarModalGoogle && (
        <div style={modalOverlay}>
          <div style={{ ...modalBox, maxWidth: '420px', padding: '32px 28px', textAlign: 'left', borderRadius: '24px' }}>

            {/* Cabeçalho Google */}
            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '20px' }}>
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <span style={{ fontSize: '0.9rem', color: '#3c4043', fontWeight: '500' }}>Fazer Login com o Google</span>
            </div>

            {/* Logo da aplicação */}
            <div style={{ marginBottom: '16px' }}>
              {LOGO_MARCA_URL && (
                <img src={LOGO_MARCA_URL} alt="Logo" style={{ height: '40px', objectFit: 'contain' }} />
              )}
            </div>

            {!modoOutraContaGoogle ? (
              <>
                <h2 style={{ margin: '0 0 6px 0', fontSize: '1.5rem', color: '#1f1f1f', fontWeight: '400' }}>
                  Escolha uma conta
                </h2>
                <p style={{ margin: '0 0 24px 0', fontSize: '0.95rem', color: '#444746' }}>
                  Prosseguir para <span style={{ color: '#0b57d0', fontWeight: '600' }}>Meu Closet Digital</span>
                </p>

                {/* Lista de Contas com Avatares Gerados */}
                <div style={{ borderTop: '1px solid #e0e0e0' }}>
                  {contasGoogleExemplo.map((conta, index) => (
                    <div
                      key={index}
                      onClick={() => selecionarContaGoogle(conta)}
                      style={{
                        display: 'flex',
                        alignItems: 'center',
                        gap: '14px',
                        padding: '14px 0',
                        borderBottom: '1px solid #e0e0e0',
                        cursor: 'pointer'
                      }}
                    >
                      <img
                        src={conta.foto}
                        alt={conta.nome}
                        style={{ width: '40px', height: '40px', borderRadius: '50%', objectFit: 'cover' }}
                      />
                      <div style={{ display: 'flex', flexDirection: 'column' }}>
                        <strong style={{ fontSize: '0.95rem', color: '#1f1f1f', fontWeight: '500' }}>{conta.nome}</strong>
                        <span style={{ fontSize: '0.85rem', color: '#5f6368' }}>{conta.email}</span>
                      </div>
                    </div>
                  ))}

                  <div
                    onClick={() => setModoOutraContaGoogle(true)}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '14px',
                      padding: '14px 0',
                      borderBottom: '1px solid #e0e0e0',
                      cursor: 'pointer'
                    }}
                  >
                    <div style={{
                      width: '40px',
                      height: '40px',
                      borderRadius: '50%',
                      border: '1px solid #dadce0',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      color: '#5f6368',
                      background: '#f8f9fa'
                    }}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                      </svg>
                    </div>
                    <span style={{ fontSize: '0.95rem', color: '#1f1f1f', fontWeight: '500' }}>Usar outra conta</span>
                  </div>
                </div>
              </>
            ) : (
              /* Formulário ao Clicar em Usar Outra Conta */
              <form onSubmit={handleEntrarComOutraContaGoogle}>
                <h2 style={{ margin: '0 0 6px 0', fontSize: '1.3rem', color: '#1f1f1f' }}>
                  Fazer login com Google
                </h2>
                <p style={{ margin: '0 0 20px 0', fontSize: '0.85rem', color: '#5f6368' }}>
                  Digite os dados de qualquer outra conta para prosseguir:
                </p>

                <div style={{ marginBottom: '12px' }}>
                  <label style={labelStyle}>Nome da Conta:</label>
                  <input
                    type="text"
                    value={novoNomeGoogle}
                    onChange={e => setNovoNomeGoogle(e.target.value)}
                    style={inputStyle}
                    placeholder="ex: João Silva"
                    required
                  />
                </div>

                <div style={{ marginBottom: '20px' }}>
                  <label style={labelStyle}>E-mail:</label>
                  <input
                    type="email"
                    value={novoEmailGoogle}
                    onChange={e => setNovoEmailGoogle(e.target.value)}
                    style={inputStyle}
                    placeholder="ex: joao@gmail.com"
                  />
                </div>

                <div style={{ display: 'flex', gap: '10px' }}>
                  <button type="submit" style={btnPrincipal}>Avançar</button>
                  <button type="button" onClick={() => setModoOutraContaGoogle(false)} style={btnAbaInativa}>Voltar</button>
                </div>
              </form>
            )}

            {/* Termos e Rodapé */}
            <p style={{ marginTop: '24px', fontSize: '0.8rem', color: '#5f6368', lineHeight: '1.4' }}>
              Consulte a <span style={{ color: '#0b57d0', cursor: 'pointer' }}>Política de Privacidade</span> e os <span style={{ color: '#0b57d0', cursor: 'pointer' }}>Termos de Serviço</span> do app Meu Closet Digital antes de usá-lo.
            </p>

            <button
              type="button"
              onClick={() => { setMostrarModalGoogle(false); setModoOutraContaGoogle(false); }}
              style={{ ...btnCancelar, marginTop: '10px' }}
            >
              Cancelar
            </button>

          </div>
        </div>
      )}

    </div>
  );
}

// ESTILOS DE COMPONENTES
const labelStyle = { display: 'block', fontSize: '0.85rem', fontWeight: '600', color: '#333333', marginBottom: '6px' };
const inputStyle = { width: '100%', padding: '12px', borderRadius: '10px', border: '1px solid #a8dcd9', boxSizing: 'border-box', background: '#fcfdfe', color: '#000000', outline: 'none', fontSize: '0.9rem' };

const btnAbaAtiva = { background: '#a8dcd9', color: '#000000', border: 'none', padding: '10px 18px', borderRadius: '25px', fontWeight: '700', cursor: 'pointer', boxShadow: '0 4px 12px rgba(168, 220, 217, 0.6)' };
const btnAbaInativa = { background: '#ffffff', color: '#555555', border: '1px solid #a8dcd9', padding: '10px 18px', borderRadius: '25px', fontWeight: '600', cursor: 'pointer' };

const btnSecundario = { background: '#a8dcd9', color: '#000000', border: 'none', padding: '10px 20px', borderRadius: '10px', cursor: 'pointer', fontWeight: 'bold', boxShadow: '0 4px 10px rgba(168, 220, 217, 0.4)' };
const btnPrincipal = { width: '100%', background: '#a8dcd9', color: '#000000', border: 'none', padding: '12px', borderRadius: '10px', cursor: 'pointer', fontWeight: 'bold', fontSize: '1rem', boxShadow: '0 4px 12px rgba(168, 220, 217, 0.5)' };
const btnEditar = { flex: 1, background: '#a8dcd9', color: '#000000', border: 'none', padding: '8px', borderRadius: '8px', cursor: 'pointer', fontWeight: 'bold' };
const btnExcluir = { flex: 1, background: '#000000', color: '#ffffff', border: 'none', padding: '8px', borderRadius: '8px', cursor: 'pointer', fontWeight: 'bold' };
const btnCancelar = { width: '100%', background: '#000000', color: '#ffffff', border: 'none', padding: '12px', borderRadius: '10px', cursor: 'pointer', fontWeight: 'bold' };
const btnGoogle = { width: '100%', background: '#ffffff', color: '#000000', border: '1px solid #a8dcd9', padding: '10px', borderRadius: '10px', cursor: 'pointer', fontWeight: '600', fontSize: '0.9rem', display: 'flex', alignItems: 'center', justifyContent: 'center' };

const btnFavoritar = {
  background: '#a8dcd9',
  color: '#000000',
  border: 'none',
  padding: '6px 14px',
  borderRadius: '20px',
  cursor: 'pointer',
  fontWeight: 'bold',
  fontSize: '0.8rem',
  whiteSpace: 'nowrap',
  boxShadow: '0 2px 8px rgba(168, 220, 217, 0.5)'
};

const modalOverlay = { position: 'fixed', top: 0, left: 0, right: 0, bottom: 0, background: 'rgba(0,0,0,0.4)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000 };
const modalBox = { background: '#ffffff', padding: '30px', borderRadius: '16px', maxWidth: '400px', width: '90%', border: '1px solid #a8dcd9', boxShadow: '0 10px 30px rgba(0,0,0,0.1)' };
const linkStyle = { color: '#000000', fontWeight: 'bold', cursor: 'pointer', textDecoration: 'underline' };

export default App;
