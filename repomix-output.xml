import React, { useState, useEffect } from 'react';
import axios from 'axios';

function AbaDiario({ pecas }) {
  const [dataSelecionada, setDataSelecionada] = useState(new Date());
  const [registros, setRegistros] = useState([]);
  const [pecasSelecionadasIds, setPecasSelecionadasIds] = useState([]);
  const [avaliacao, setAvaliacao] = useState(5);
  const [comentario, setComentario] = useState('');
  const [status, setStatus] = useState('');

  const anoAtual = dataSelecionada.getFullYear();
  const mesAtual = dataSelecionada.getMonth();

  const formatarDataIso = (d) => {
    const ano = d.getFullYear();
    const mes = String(d.getMonth() + 1).padStart(2, '0');
    const dia = String(d.getDate()).padStart(2, '0');
    return `${ano}-${mes}-${dia}`;
  };

  const dataFormatada = formatarDataIso(dataSelecionada);

  useEffect(() => {
    carregarDiario();
  }, []);

  const carregarDiario = () => {
    const token = localStorage.getItem('token');
    const headers = token ? { Authorization: `Token ${token}` } : {};

    axios.get('http://127.0.0.1:8000/api/diario/', { headers })
      .then(res => setRegistros(Array.isArray(res.data) ? res.data : []))
      .catch(err => console.error("Erro ao carregar diário:", err));
  };

  const registroDoDia = registros.find(r => r.data === dataFormatada);

  useEffect(() => {
    if (registroDoDia) {
      if (registroDoDia.pecas) {
        setPecasSelecionadasIds(registroDoDia.pecas);
      } else if (registroDoDia.pecas_detalhes) {
        setPecasSelecionadasIds(registroDoDia.pecas_detalhes.map(p => p.id));
      }
      setAvaliacao(registroDoDia.avaliacao || 5);
      setComentario(registroDoDia.comentario || '');
    } else {
      setPecasSelecionadasIds([]);
      setAvaliacao(5);
      setComentario('');
    }
  }, [dataFormatada, registros]);

  const handleTogglePeca = (id) => {
    if (pecasSelecionadasIds.includes(id)) {
      setPecasSelecionadasIds(pecasSelecionadasIds.filter(item => item !== id));
    } else {
      setPecasSelecionadasIds([...pecasSelecionadasIds, id]);
    }
  };

  const handleSalvarDiario = () => {
    setStatus('Salvando...');
    const token = localStorage.getItem('token');
    const headers = token ? { Authorization: `Token ${token}` } : {};

    const payload = {
      data: dataFormatada,
      pecas: pecasSelecionadasIds,
      avaliacao: avaliacao,
      comentario: comentario
    };

    if (registroDoDia) {
      axios.patch(`http://127.0.0.1:8000/api/diario/${registroDoDia.id}/`, payload, { headers })
        .then(() => {
          setStatus('Atualizado com sucesso!');
          carregarDiario();
        })
        .catch(err => {
          console.error("Erro no patch:", err.response?.data || err);
          setStatus('Erro ao atualizar.');
        });
    } else {
      axios.post('http://127.0.0.1:8000/api/diario/', payload, { headers })
        .then(() => {
          setStatus('Salvo com sucesso!');
          carregarDiario();
        })
        .catch(err => {
          console.error("Erro no post:", err.response?.data || err);
          setStatus('Erro ao salvar.');
        });
    }
  };

  const primeiroDiaDoMes = new Date(anoAtual, mesAtual, 1).getDay();
  const diasNoMes = new Date(anoAtual, mesAtual + 1, 0).getDate();

  const renderDiasCalendario = () => {
    const celulas = [];
    for (let i = 0; i < primeiroDiaDoMes; i++) {
      celulas.push(<div key={`empty-${i}`} style={{ background: '#fdfdfd', border: '1px solid #f0f0f0', borderRadius: '8px', minHeight: '65px' }} />);
    }

    for (let dia = 1; dia <= diasNoMes; dia++) {
      const dataCelula = new Date(anoAtual, mesAtual, dia);
      const isoData = formatarDataIso(dataCelula);
      const eHoje = isoData === dataFormatada;
      const reg = registros.find(r => r.data === isoData);

      celulas.push(
        <div
          key={dia}
          onClick={() => {
            setDataSelecionada(dataCelula);
            setStatus('');
          }}
          style={{
            border: eHoje ? '2px solid #000000' : '1px solid #a8dcd9',
            background: eHoje ? '#e3f7f6' : '#ffffff',
            borderRadius: '8px',
            padding: '4px',
            minHeight: '65px',
            cursor: 'pointer',
            display: 'flex',
            flexDirection: 'column',
            justify: 'space-between',
            boxSizing: 'border-box'
          }}
        >
          <span style={{ fontSize: '0.75rem', fontWeight: 'bold', color: '#000000' }}>{dia}</span>
          <div style={{ display: 'flex', gap: '2px', flexWrap: 'wrap', overflow: 'hidden', maxHeight: '40px' }}>
            {reg && reg.pecas_detalhes && reg.pecas_detalhes.map((p, idx) => (
              <img
                key={idx}
                src={p.imagem?.startsWith('http') ? p.imagem : `http://127.0.0.1:8000${p.imagem}`}
                alt={p.categoria}
                style={{ width: '18px', height: '18px', objectFit: 'cover', borderRadius: '3px' }}
              />
            ))}
          </div>
        </div>
      );
    }
    return celulas;
  };

  const meses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];

  return (
    <div style={{ background: '#ffffff', padding: '30px', borderRadius: '20px', border: '1px solid #a8dcd9', boxShadow: '0 10px 25px rgba(0,0,0,0.03)' }}>
      <h2 style={{ color: '#000000', marginTop: 0 }}>Agenda do Closet</h2>
      <p style={{ color: '#555555', fontSize: '0.9rem' }}>Selecione um dia para registrar as roupas que você usou:</p>

      <div style={{ display: 'grid', gridTemplateColumns: '1.2fr 0.8fr', gap: '30px', marginTop: '20px' }}>
        <div>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '10px' }}>
            <button
              onClick={() => setDataSelecionada(new Date(anoAtual, mesAtual - 1, 1))}
              style={{ background: '#a8dcd9', border: 'none', borderRadius: '6px', padding: '4px 10px', cursor: 'pointer', fontWeight: 'bold' }}
            >
              &lt;
            </button>
            <strong style={{ fontSize: '1rem', color: '#000000' }}>{meses[mesAtual]} {anoAtual}</strong>
            <button
              onClick={() => setDataSelecionada(new Date(anoAtual, mesAtual + 1, 1))}
              style={{ background: '#a8dcd9', border: 'none', borderRadius: '6px', padding: '4px 10px', cursor: 'pointer', fontWeight: 'bold' }}
            >
              &gt;
            </button>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '4px', textAlign: 'center', fontWeight: 'bold', fontSize: '0.75rem', marginBottom: '6px', color: '#555' }}>
            <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '4px' }}>
            {renderDiasCalendario()}
          </div>
        </div>

        <div>
          <h3 style={{ margin: '0 0 10px 0', fontSize: '1.1rem', color: '#000000' }}>
            Data: {dataSelecionada.toLocaleDateString('pt-BR')}
          </h3>

          <p style={{ fontSize: '0.85rem', fontWeight: '600', color: '#333' }}>Selecione as peças para esta data:</p>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '10px', maxHeight: '160px', overflowY: 'auto', paddingRight: '5px' }}>
            {pecas.map(peca => {
              const selecionada = pecasSelecionadasIds.includes(peca.id);
              const imgUrl = peca.imagem?.startsWith('http') ? peca.imagem : `http://127.0.0.1:8000${peca.imagem}`;
              return (
                <div
                  key={peca.id}
                  onClick={() => handleTogglePeca(peca.id)}
                  style={{
                    border: selecionada ? '2px solid #000000' : '1px solid #a8dcd9',
                    borderRadius: '10px',
                    padding: '6px',
                    cursor: 'pointer',
                    background: selecionada ? '#a8dcd9' : '#ffffff',
                    textAlign: 'center'
                  }}
                >
                  <img src={imgUrl} alt={peca.categoria} style={{ width: '100%', height: '50px', objectFit: 'cover', borderRadius: '6px' }} />
                  <span style={{ fontSize: '0.7rem', display: 'block', textTransform: 'capitalize', fontWeight: 'bold' }}>{peca.categoria}</span>
                </div>
              );
            })}
          </div>

          <div style={{ marginTop: '12px' }}>
            <label style={{ fontSize: '0.8rem', fontWeight: 'bold', display: 'block', marginBottom: '4px', color: '#333' }}>
              Avaliação do Look:
            </label>
            <select
              value={avaliacao}
              onChange={(e) => setAvaliacao(Number(e.target.value))}
              style={{ width: '100%', padding: '6px 10px', borderRadius: '8px', border: '1px solid #a8dcd9', fontSize: '0.85rem', outline: 'none' }}
            >
              <option value={1}>⭐ (1/5)</option>
              <option value={2}>⭐⭐ (2/5)</option>
              <option value={3}>⭐⭐⭐ (3/5)</option>
              <option value={4}>⭐⭐⭐⭐ (4/5)</option>
              <option value={5}>⭐⭐⭐⭐⭐ (5/5)</option>
            </select>
          </div>

          <div style={{ marginTop: '10px' }}>
            <label style={{ fontSize: '0.8rem', fontWeight: 'bold', display: 'block', marginBottom: '4px', color: '#333' }}>
              Anotações:
            </label>
            <textarea
              value={comentario}
              onChange={(e) => setComentario(e.target.value)}
              placeholder="Ex: Achei a sobreposição bem estilosa"
              style={{
                width: '100%',
                height: '45px',
                padding: '6px 10px',
                borderRadius: '8px',
                border: '1px solid #a8dcd9',
                fontSize: '0.8rem',
                boxSizing: 'border-box',
                resize: 'none',
                outline: 'none',
                fontFamily: 'inherit'
              }}
            />
          </div>

          <button
            onClick={handleSalvarDiario}
            style={{ width: '100%', marginTop: '15px', background: '#a8dcd9', color: '#000000', border: 'none', padding: '12px', borderRadius: '10px', fontWeight: 'bold', cursor: 'pointer' }}
          >
            {registroDoDia ? 'Atualizar Look do Dia' : 'Salvar Look do Dia'}
          </button>

          {status && <p style={{ fontSize: '0.85rem', fontWeight: 'bold', marginTop: '10px', textAlign: 'center' }}>{status}</p>}
        </div>
      </div>
    </div>
  );
}

export default AbaDiario;
</file>

