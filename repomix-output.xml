const GraficoRosquinha = ({ dados, total }) => {
  const CORES = ['#2cb3a6', '#66d4ca', '#222222', '#e0c38c', '#a8d5e2', '#1d8a80'];

  if (!dados || dados.length === 0) {
    return <p style={{ color: '#999', fontSize: '0.85rem', margin: '20px 0' }}>Sem dados para exibir.</p>;
  }

  let acumulado = 0;
  const fatias = dados.map((item) => {
    const porcentagem = total > 0 ? (item.value / total) * 100 : 0;
    const inicio = acumulado;
    acumulado += porcentagem;
    return { name: item.name, porcentagem: Math.round(porcentagem), inicio, fim: acumulado };
  });

  const gradienteConico = fatias
    .map((f, i) => `${CORES[i % CORES.length]} ${f.inicio}% ${f.fim}%`)
    .join(', ');

  return (
    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '15px', width: '100%', padding: '10px 0' }}>
      <div
        style={{
          width: '110px',
          height: '110px',
          borderRadius: '50%',
          background: fatias.length > 0 ? `conic-gradient(${gradienteConico})` : '#eee',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          flexShrink: 0
        }}
      >
        <div
          style={{
            width: '65px',
            height: '65px',
            borderRadius: '50%',
            background: '#ffffff',
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'center',
            justifyContent: 'center'
          }}
        >
          <strong style={{ fontSize: '1.2rem', color: '#111', lineHeight: '1' }}>{total}</strong>
          <span style={{ fontSize: '0.68rem', color: '#777' }}>peças</span>
        </div>
      </div>

      <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', width: '100%', overflow: 'hidden' }}>
        {fatias.map((f, i) => (
          <div key={i} style={{ display: 'flex', alignItems: 'center', gap: '8px', fontSize: '0.82rem' }}>
            <span style={{ width: '8px', height: '8px', borderRadius: '50%', background: CORES[i % CORES.length], flexShrink: 0 }}></span>
            <span style={{ color: '#444', fontWeight: '500', textTransform: 'capitalize', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
              {f.name}
            </span>
            <strong style={{ color: '#111', marginLeft: 'auto', flexShrink: 0 }}>{f.porcentagem}%</strong>
          </div>
        ))}
      </div>
    </div>
  );
};

function AbaDashboard({ pecas = [], registros = [], favoritos = [] }) {
  const totalPecas = pecas.length;
  const totalLooks = registros.length;

  const favoritosDasPecas = pecas.filter(p => p.favorito || p.is_favorite).length;
  const favoritosDosRegistros = registros.filter(r => r.favorito || r.is_favorite).length;
  const totalFavoritos = (favoritos ? favoritos.length : 0) || favoritosDasPecas || favoritosDosRegistros;

  const avaliacoesValidas = registros
    .map((r) => {
      const val = r.avaliacao ?? r.nota ?? r.rating ?? r.estrela ?? r.estrelas;
      return Number(val);
    })
    .filter((v) => !isNaN(v) && v > 0);

  const mediaAvaliacao = avaliacoesValidas.length > 0
    ? (avaliacoesValidas.reduce((a, b) => a + b, 0) / avaliacoesValidas.length).toFixed(1)
    : '0.0';

  const pecasUsadasContagem = {};
  registros.forEach((reg) => {
    const listaPecas = reg.pecas || reg.items || reg.pecas_ids || [];
    if (Array.isArray(listaPecas)) {
      listaPecas.forEach((p) => {
        const id = typeof p === 'object' ? p.id : p;
        if (id) pecasUsadasContagem[id] = (pecasUsadasContagem[id] || 0) + 1;
      });
    }
  });

  const qtdPecasUsadas = Object.keys(pecasUsadasContagem).length;
  const porcentagemUsadas = totalPecas > 0 ? Math.round((qtdPecasUsadas / totalPecas) * 100) : 0;

  const agruparPor = (chave) => {
    const contagem = pecas.reduce((acc, p) => {
      const valor = p[chave] || 'Outros';
      acc[valor] = (acc[valor] || 0) + 1;
      return acc;
    }, {});
    return Object.entries(contagem).map(([name, value]) => ({ name, value }));
  };

  const dadosCategoria = agruparPor('categoria');
  const dadosCores = agruparPor('cor');
  const dadosEstilos = agruparPor('estilo');
  const dadosClima = agruparPor('estacao');

  const maxQtdCategoria = Math.max(...dadosCategoria.map((d) => d.value), 1);

  const pecasComUso = pecas.map((p) => ({
    ...p,
    qtdUso: pecasUsadasContagem[p.id] || 0
  }));

  const pecasMaisUsadas = [...pecasComUso].sort((a, b) => b.qtdUso - a.qtdUso).slice(0, 5);
  const pecasEsquecidas = pecasComUso.filter((p) => p.qtdUso <= 1).slice(0, 3);

  const cardTop = {
    flex: '1 1 200px',
    background: '#fff',
    border: '1px solid #d8f3f0',
    borderRadius: '16px',
    padding: '20px',
    position: 'relative',
    boxSizing: 'border-box'
  };

  const iconCircle = {
    width: '38px',
    height: '38px',
    borderRadius: '50%',
    background: '#b2ece7',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    position: 'absolute',
    top: '20px',
    right: '20px'
  };

  const blockBox = {
    flex: '1 1 340px',
    background: '#fff',
    border: '1px solid #d8f3f0',
    borderRadius: '16px',
    padding: '20px',
    boxSizing: 'border-box',
    overflow: 'hidden'
  };

  return (
    <div style={{ padding: '10px 0', fontFamily: 'sans-serif' }}>
      <h2 style={{ fontSize: '1.8rem', color: '#1a1a1a', margin: '0 0 5px 0' }}>Dashboard do Closet</h2>
      <p style={{ color: '#666', marginBottom: '25px', fontSize: '0.95rem' }}>
        Visão geral do seu guarda-roupa, das peças que você mais usa e dos looks avaliados.
      </p>

      <div style={{ display: 'flex', gap: '15px', flexWrap: 'wrap', marginBottom: '25px' }}>
        <div style={cardTop}>
          <div style={iconCircle}><Icone tipo="cabide" /></div>
          <span style={{ fontSize: '0.88rem', color: '#555', fontWeight: '500' }}>Peças no closet</span>
          <h3 style={{ fontSize: '2.2rem', margin: '12px 0 4px 0', color: '#111' }}>{totalPecas}</h3>
          <span style={{ fontSize: '0.78rem', color: '#777' }}>{porcentagemUsadas}% já foram usadas</span>
        </div>

        <div style={cardTop}>
          <div style={iconCircle}><Icone tipo="calendario" /></div>
          <span style={{ fontSize: '0.88rem', color: '#555', fontWeight: '500' }}>Looks registrados</span>
          <h3 style={{ fontSize: '2.2rem', margin: '12px 0 4px 0', color: '#111' }}>{totalLooks}</h3>
          <span style={{ fontSize: '0.78rem', color: '#777' }}>no Diário de Looks</span>
        </div>

        <div style={cardTop}>
          <div style={iconCircle}><Icone tipo="coracao" /></div>
          <span style={{ fontSize: '0.88rem', color: '#555', fontWeight: '500' }}>Looks favoritos</span>
          <h3 style={{ fontSize: '2.2rem', margin: '12px 0 4px 0', color: '#111' }}>{totalFavoritos}</h3>
          <span style={{ fontSize: '0.78rem', color: '#777' }}>combinações salvas</span>
        </div>

        <div style={cardTop}>
          <div style={iconCircle}><Icone tipo="estrela" /></div>
          <span style={{ fontSize: '0.88rem', color: '#555', fontWeight: '500' }}>Avaliação média</span>
          <h3 style={{ fontSize: '2.2rem', margin: '12px 0 4px 0', color: '#111' }}>{mediaAvaliacao}</h3>
          <span style={{ fontSize: '0.78rem', color: '#777' }}>de 5 estrelas</span>
        </div>
      </div>

      <div style={{ display: 'flex', gap: '20px', flexWrap: 'wrap', marginBottom: '20px' }}>
        {/* Gráfico de Barras por Categoria com Rolagem Segura */}
        <div style={blockBox}>
          <h4 style={{ margin: '0 0 5px 0', fontSize: '1.1rem', color: '#222' }}>Peças por categoria</h4>
          <p style={{ margin: '0 0 20px 0', fontSize: '0.85rem', color: '#777' }}>Quantidade de peças cadastradas em cada categoria.</p>

          <div style={{ width: '100%', overflowX: 'auto', paddingBottom: '10px' }}>
            <div style={{ display: 'flex', alignItems: 'flex-end', gap: '12px', height: '140px', minWidth: `${dadosCategoria.length * 60}px`, paddingBottom: '30px', borderBottom: '1px solid #eee' }}>
              {dadosCategoria.map((cat, idx) => {
                const alturaPorcentagem = (cat.value / maxQtdCategoria) * 100;
                return (
                  <div key={idx} style={{ flex: '1 1 0', minWidth: '45px', display: 'flex', flexDirection: 'column', alignItems: 'center', height: '100%', justifyContent: 'flex-end', position: 'relative' }}>
                    <span style={{ fontSize: '0.75rem', fontWeight: 'bold', color: '#2cb3a6', marginBottom: '4px' }}>{cat.value}</span>
                    <div style={{ width: '28px', height: `${alturaPorcentagem}%`, background: '#2cb3a6', borderRadius: '6px 6px 0 0', minHeight: '6px' }} />
                    <span style={{ position: 'absolute', bottom: '-25px', fontSize: '0.72rem', color: '#666', textTransform: 'capitalize', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', maxWidth: '55px', textAlign: 'center' }}>
                      {cat.name}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        <div style={blockBox}>
          <h4 style={{ margin: '0 0 5px 0', fontSize: '1.1rem', color: '#222' }}>Cores do closet</h4>
          <p style={{ margin: '0 0 15px 0', fontSize: '0.85rem', color: '#777' }}>Paleta predominante do guarda-roupa.</p>
          <GraficoRosquinha dados={dadosCores} total={totalPecas} />
        </div>
      </div>

      <div style={{ display: 'flex', gap: '20px', flexWrap: 'wrap', marginBottom: '20px' }}>
        <div style={blockBox}>
          <h4 style={{ margin: '0 0 5px 0', fontSize: '1.1rem', color: '#222' }}>Estilos</h4>
          <p style={{ margin: '0 0 15px 0', fontSize: '0.85rem', color: '#777' }}>Como o seu closet se divide por estilo.</p>
          <GraficoRosquinha dados={dadosEstilos} total={totalPecas} />
        </div>

        <div style={blockBox}>
          <h4 style={{ margin: '0 0 5px 0', fontSize: '1.1rem', color: '#222' }}>Clima ideal</h4>
          <p style={{ margin: '0 0 15px 0', fontSize: '0.85rem', color: '#777' }}>Peças disponíveis para cada estação.</p>
          <GraficoRosquinha dados={dadosClima} total={totalPecas} />
        </div>
      </div>

      <div style={{ display: 'flex', gap: '20px', flexWrap: 'wrap' }}>
        <div style={blockBox}>
          <h4 style={{ margin: '0 0 5px 0', fontSize: '1.1rem', color: '#222' }}>Peças mais usadas</h4>
          <p style={{ margin: '0 0 15px 0', fontSize: '0.85rem', color: '#777' }}>Com base nos registros do Diário de Looks.</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            {pecasMaisUsadas.length > 0 ? (
              pecasMaisUsadas.map((peca) => (
                <div key={peca.id} style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '10px 14px', background: '#f4fbfb', borderRadius: '14px', border: '1px solid #e1f5f3' }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                    <img src={peca.imagem || peca.foto || peca.url || 'https://via.placeholder.com/50'} alt={peca.nome} style={{ width: '45px', height: '45px', borderRadius: '10px', objectFit: 'cover' }} />
                    <div>
                      <strong style={{ fontSize: '0.88rem', color: '#222' }}>{peca.nome || `${peca.categoria} - ${peca.cor}`}</strong>
                      <p style={{ margin: '2px 0 0 0', fontSize: '0.78rem', color: '#666' }}>{peca.estilo || 'Casual'} · {peca.estacao || 'Todas'}</p>
                    </div>
                  </div>
                  <span style={{ background: '#b2ece7', color: '#005f56', padding: '4px 10px', borderRadius: '12px', fontWeight: 'bold', fontSize: '0.85rem' }}>{peca.qtdUso}x</span>
                </div>
              ))
            ) : (
              <p style={{ fontSize: '0.88rem', color: '#999' }}>Nenhuma peça registrada ainda.</p>
            )}
          </div>
        </div>

        <div style={blockBox}>
          <h4 style={{ margin: '0 0 5px 0', fontSize: '1.1rem', color: '#222' }}>Peças esquecidas</h4>
          <p style={{ margin: '0 0 15px 0', fontSize: '0.85rem', color: '#777' }}>Usadas uma vez ou nunca. Que tal incluir no próximo look?</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            {pecasEsquecidas.length > 0 ? (
              pecasEsquecidas.map((peca) => (
                <div key={peca.id} style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '10px 14px', background: '#fcfcfc', borderRadius: '14px', border: '1px solid #eee' }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                    <img src={peca.imagem || peca.foto || peca.url || 'https://via.placeholder.com/50'} alt={peca.nome} style={{ width: '45px', height: '45px', borderRadius: '10px', objectFit: 'cover' }} />
                    <div>
                      <strong style={{ fontSize: '0.88rem', color: '#222' }}>{peca.nome || `${peca.categoria} - ${peca.cor}`}</strong>
                      <p style={{ margin: '2px 0 0 0', fontSize: '0.78rem', color: '#666' }}>{peca.estilo || 'Casual'} · {peca.estacao || 'Todas'}</p>
                    </div>
                  </div>
                  <span style={{ background: '#f0f0f0', color: '#666', padding: '4px 10px', borderRadius: '12px', fontWeight: 'bold', fontSize: '0.85rem' }}>{peca.qtdUso}x</span>
                </div>
              ))
            ) : (
              <p style={{ fontSize: '0.88rem', color: '#999' }}>Nenhuma peça esquecida!</p>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

export default AbaDashboard;
